# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Porta do servidor
PORT=3000

# Chave secreta de sessão de autenticação (min 32 caracteres)
SESSION_SECRET="delivale_super_secret_session_key_production_32chars"

# Chave mestre de criptografia AES-256-GCM para segredos em repouso (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Banco de Dados PostgreSQL (opcional; se não informado ou indisponível, usa persistência em arquivo seguro ./data)
DATABASE_URL="postgresql://delivale_user:delivale_pass@localhost:5432/delivale_followup?schema=public"

# Configuração Opcional da Evolution API WhatsApp
EVOLUTION_API_URL="https://evolution.seuservidor.com"
EVOLUTION_API_KEY="B6D711FCDE4D4FD5936544120E713976"
EVOLUTION_INSTANCE_NAME="delivale_bot"

